# Version
version

# Profile creation
profile create profile1

# Logger creation
log create log1 verbose

# Dialog creation
node config create config1 executor-config.json
node config bind profile config1 profile1
node config bind log config1 log1
node create node1 config1

# set Data
node set data node1 input-config.json

# excute
node execute node1

#get data
node get data node1 output-config.json outputs

# sampler
sampler config create sconfig1 standalone-sampler.json
sampler create sampler1 sconfig1
sampler sampleData sampler1 outputs/logits_0.raw outputs/logits_0.json

# Clean up
node config free config1
node free node1
sampler config free sconfig1
sampler free sampler1
profile free profile1
log free log1

# Exit
exit

