SOURCES := main.cpp

GENIE_C_API_HEADERS_INCLUDE := ../../../include/Genie
GENIE_CPP_HEADERS_INCLUDE   := include

# Cross compiler (can be overridden by environment)
CXX ?= aarch64-oe-linux-g++
CC  ?= aarch64-oe-linux-gcc

# Optional sysroot from OE SDK
SYSROOT ?=
ifneq ($(OECORE_TARGET_SYSROOT),)
  SYSROOT := $(OECORE_TARGET_SYSROOT)
endif
ifneq ($(SDKTARGETSYSROOT),)
  SYSROOT := $(SDKTARGETSYSROOT)
endif

QNN_TARGET ?= aarch64-oe-linux-gcc11.2
export TARGET_DIR := ./bin/$(QNN_TARGET)

genie-app := $(TARGET_DIR)/genie-app

all: $(genie-app)

# Include paths
INCLUDES += -I$(GENIE_C_API_HEADERS_INCLUDE) -I$(GENIE_CPP_HEADERS_INCLUDE) -I../Genie/src/qualla/include

# Compose optional sysroot flag
SYSROOT_FLAG :=
ifneq ($(SYSROOT),)
  SYSROOT_FLAG := --sysroot=$(SYSROOT)
endif

# Compiler/Linker flags
COMMON_CXXFLAGS = -std=c++2a -frtti -fPIC -Wall -g -pthread -O3 -Wno-write-strings -fvisibility=hidden $(INCLUDES) $(SYSROOT_FLAG)
COMMON_CFLAGS   = -Wall -g $(INCLUDES) $(SYSROOT_FLAG)
COMMON_LDFLAGS  = -L../../../lib/aarch64-oe-linux-gcc11.2 -lGenie $(SYSROOT_FLAG)

CXXFLAGS += $(COMMON_CXXFLAGS)
CFLAGS   += $(COMMON_CFLAGS)
LDFLAGS  += $(COMMON_LDFLAGS)

OBJ_DIR_MAIN := obj/$(QNN_TARGET)
LIBS := -ldl

.PHONY: genie-app
genie-app: $(genie-app)

$(OBJ_DIR_MAIN)/%.o: main.cpp | $(OBJ_DIR_MAIN)
	$(CXX) $(CXXFLAGS) -c $^ -o $@

directories := $(TARGET_DIR) $(OBJ_DIR_MAIN)

$(genie-app): $(OBJ_DIR_MAIN)/main.o | $(directories)
	# Link objects first, then libraries to satisfy symbol resolution
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(LIBS)

$(directories):
	mkdir -p $@

.PHONY: clean
clean:
	rm -rf obj $(TARGET_DIR)
