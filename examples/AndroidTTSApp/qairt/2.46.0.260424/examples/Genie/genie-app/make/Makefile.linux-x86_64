SOURCES := main.cpp

GENIE_C_API_HEADERS_INCLUDE := ../../../include/Genie
GENIE_CPP_HEADERS_INCLUDE   := include

# Checking if clang++ is present. If not switch to clang++
ifeq ($(shell $(CXX) -v 2>&1 | grep -c "clang version"), 0)
CXX := clang++
endif

QNN_TARGET ?= x86_64-linux-clang
export TARGET_DIR := ./bin/$(QNN_TARGET)

genie-app := $(TARGET_DIR)/genie-app


# define target architecture if not previously defined, default is x86
ifndef TARGET_AARCH_VARS
TARGET_AARCH_VARS:= -march=x86-64
endif

all: $(genie-app)


# Include paths
INCLUDES += -I$(GENIE_C_API_HEADERS_INCLUDE) -I$(GENIE_CPP_HEADERS_INCLUDE) -I../Genie/src/qualla/include

## Detect clang++ and its resource include dir, and use system libc++ headers if available.
CLANG_RESOURCE_DIR := $(shell $(CXX) -print-resource-dir 2>/dev/null)
ifeq ($(CLANG_RESOURCE_DIR),)
  # Fallback to clang-9 prebuilt in QNN tools if default CXX doesn't support -print-resource-dir
  CXX := clang++
  CLANG_RESOURCE_DIR := $(shell $(CXX) -print-resource-dir 2>/dev/null)
endif

# Prefer libc++ headers shipped with clang if system libc++ is not in /usr/include/c++/v1
LIBCXX_INCLUDE_DIR ?= $(shell if [ -d /usr/include/c++/v1 ]; then echo /usr/include/c++/v1; elif [ -d /usr/lib/llvm-14/include/c++/v1 ]; then echo /usr/lib/llvm-14/include/c++/v1; else echo ; fi)

# Compose include flags using -isystem to ensure proper include_next behavior.
INCLUDE_AFTER :=
ifneq ($(LIBCXX_INCLUDE_DIR),)
  INCLUDE_AFTER += -isystem $(LIBCXX_INCLUDE_DIR)
endif
ifneq ($(CLANG_RESOURCE_DIR),)
  INCLUDE_AFTER += -isystem $(CLANG_RESOURCE_DIR)/include
endif
INCLUDE_AFTER += -isystem /usr/include

# set compiler flags
COMMON_CXXFLAGS = -std=c++2a -frtti -fPIC -Wall -g -pthread -nostdinc++ -stdlib=libc++ $(INCLUDE_AFTER) $(INCLUDES)
COMMON_LDFLAGS = -L../../../lib/x86_64-linux-clang -lGenie

COMMON_CFLAGS = -nostdinc $(INCLUDE_AFTER)

#TODO configure for these feature flags
CXXFLAGS += $(COMMON_CXXFLAGS) -march=x86-64 -O3 -Wno-write-strings -fvisibility=hidden 
CFLAGS += $(COMMON_CFLAGS)
LDFLAGS += $(COMMON_LDFLAGS) -fvisibility=hidden -flto


OBJ_DIR_MAIN := obj/$(QNN_TARGET)
LIBS=-ldl

# Rule to make shared lib
.PHONY: genie-app
genie-app: $(genie-app)

# Compile rules
$(OBJ_DIR_MAIN)/%.o: main.cpp
	$(CXX) $(CXXFLAGS) -c $^ -o $@

# set up resources
directories := $(TARGET_DIR) $(OBJ_DIR_MAIN)

$(genie-app): $(OBJ_DIR_MAIN)/main.o | $(directories)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)


$(OBJ_DIR_MAIN)/main.o: | $(OBJ_DIR_MAIN)

# rule to create directories
$(directories):
	mkdir -p $@

.PHONY: clean
clean:
	rm -rf obj $(TARGET_DIR)
