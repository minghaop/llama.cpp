# ----------------------------------------------------------------------------
# Project Directories
# ----------------------------------------------------------------------------
MAKEFILE_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
PROJECT_ROOT := $(abspath $(MAKEFILE_DIR)/..)
SRC_DIR      := $(PROJECT_ROOT)/src
QUALLA_DIR   := $(SRC_DIR)/qualla

# ----------------------------------------------------------------------------
# Source Directories
# ----------------------------------------------------------------------------

# Genie Core
SRC_DIR_GENIE          := $(SRC_DIR)
SRC_DIR_GENIE_PIPELINE := $(SRC_DIR)/pipeline
SRC_DIR_GENIE_TRACE    := $(SRC_DIR)/trace/src
SRC_DIR_GENIE_QUANT    := $(SRC_DIR)/quantization/src

# Qualla Core & Modules
SRC_DIR_QUALLA_CORE      := $(QUALLA_DIR)
SRC_DIR_QUALLA_STATE     := $(QUALLA_DIR)/engine-state
SRC_DIR_TOKENIZERS       := $(QUALLA_DIR)/tokenizers
SRC_DIR_ADAPTORS         := $(QUALLA_DIR)/adaptors
SRC_DIR_DIALOGS          := $(QUALLA_DIR)/dialogs
SRC_DIR_TEXT_ENCODERS    := $(QUALLA_DIR)/encoders/text-encoders
SRC_DIR_IMAGE_ENCODERS   := $(QUALLA_DIR)/encoders/image-encoders
SRC_DIR_ENGINES          := $(QUALLA_DIR)/engines
SRC_DIR_UTILS            := $(QUALLA_DIR)/utils
SRC_DIR_LOGGERS          := $(QUALLA_DIR)/loggers
SRC_DIR_SAMPLERS         := $(QUALLA_DIR)/samplers
SRC_DIR_MMAPPED_UTILS    := $(QUALLA_DIR)/MmappedFile/src

# Engines Subdirectories
SRC_DIR_QNN_API         := $(SRC_DIR_ENGINES)/qnn-api
SRC_DIR_QNN_CPU         := $(SRC_DIR_ENGINES)/qnn-cpu
SRC_DIR_QNN_GPU         := $(SRC_DIR_ENGINES)/qnn-gpu
SRC_DIR_QNN_HTP         := $(SRC_DIR_ENGINES)/qnn-htp

# Engines qnn-api Subdirectories
SRC_DIR_QNN_API_CONFIG        := $(SRC_DIR_QNN_API)/config
SRC_DIR_QNN_API_BUFFER        := $(SRC_DIR_QNN_API)/buffer
SRC_DIR_QNN_API_BUFFER_ALLOC  := $(SRC_DIR_QNN_API_BUFFER)/Allocator
SRC_DIR_QNN_API_BUFFER_REG    := $(SRC_DIR_QNN_API_BUFFER)/Registration
SRC_DIR_QNN_API_PAL           := $(SRC_DIR_QNN_API)/PAL
SRC_DIR_QNN_API_PAL_LINUX     := $(SRC_DIR_QNN_API_PAL)/linux

# Engines qnn-htp Subdirectories
SRC_DIR_QNN_NSP_UTILS         := $(SRC_DIR_QNN_HTP)/nsp-utils
SRC_DIR_QNN_KV_CACHE          := $(SRC_DIR_QNN_HTP)/KVCache

# ----------------------------------------------------------------------------
# Include Directories
# ----------------------------------------------------------------------------
GENIE_INCLUDE              := $(PROJECT_ROOT)/include
GENIE_SRC_INCLUDE          := $(SRC_DIR)
GENIE_PIPELINE_INCLUDE     := $(SRC_DIR)/pipeline
GENIE_TRACE_INCLUDE        := $(SRC_DIR)/trace/include
GENIE_QUANT_INCLUDE        := $(SRC_DIR)/quantization/include
QUALLA_INCLUDE             := $(QUALLA_DIR)/include
QUALLA_INCLUDE_QUALLA      := $(QUALLA_DIR)/include/qualla
QUALLA_TOKENIZERS_INCLUDE  := $(QUALLA_DIR)/tokenizers
QUALLA_ADAPTORS_INCLUDE    := $(QUALLA_DIR)/adaptors
QUALLA_DIALOGS_INCLUDE     := $(QUALLA_DIR)/dialogs
QUALLA_MMAPPED_INCLUDE     := $(QUALLA_DIR)/MmappedFile/include
QUALLA_LOGGERS_INCLUDE     := $(QUALLA_DIR)/loggers
QUALLA_SAMPLERS_INCLUDE    := $(QUALLA_DIR)/samplers
QUALLA_STATE_INCLUDE       := $(QUALLA_DIR)/engine-state

# QNN SDK Includes
QNN_API_INCLUDE            := $(QNN_SDK_ROOT)/include/QNN
QNN_API_HTP_INCLUDE        := $(QNN_API_INCLUDE)/HTP
GENIE_C_API_HEADERS        := $(QNN_SDK_ROOT)/include/Genie

INCLUDES := -I$(GENIE_INCLUDE) \
			-I$(GENIE_SRC_INCLUDE) \
			-I$(GENIE_PIPELINE_INCLUDE) \
			-I$(GENIE_TRACE_INCLUDE) \
			-I$(GENIE_QUANT_INCLUDE) \
			-I$(QUALLA_INCLUDE) \
			-I$(QUALLA_INCLUDE_QUALLA) \
			-I$(QUALLA_TOKENIZERS_INCLUDE) \
			-I$(QUALLA_ADAPTORS_INCLUDE) \
			-I$(QUALLA_DIALOGS_INCLUDE) \
			-I$(QUALLA_MMAPPED_INCLUDE) \
			-I$(QUALLA_LOGGERS_INCLUDE) \
			-I$(QUALLA_SAMPLERS_INCLUDE) \
			-I$(QUALLA_STATE_INCLUDE) \
			-I$(SRC_DIR_QNN_API) \
			-I$(SRC_DIR_QNN_API_CONFIG) \
			-I$(SRC_DIR_QNN_API_BUFFER) \
			-I$(SRC_DIR_QNN_API_BUFFER_ALLOC) \
			-I$(SRC_DIR_QNN_API_BUFFER_REG) \
			-I$(SRC_DIR_QNN_API_PAL) \
			-I$(SRC_DIR_QNN_API_PAL_LINUX) \
			-I$(SRC_DIR_QNN_CPU) \
			-I$(SRC_DIR_QNN_GPU) \
			-I$(SRC_DIR_QNN_HTP) \
			-I$(SRC_DIR_QNN_KV_CACHE) \
			-I$(SRC_DIR_QNN_NSP_UTILS) \
			-I$(QNN_API_INCLUDE) \
			-I$(QNN_API_HTP_INCLUDE) \
			-I$(GENIE_C_API_HEADERS)

# ----------------------------------------------------------------------------
# Target & Flags
# ----------------------------------------------------------------------------
QNN_TARGET  ?= aarch64-qnx800
RUST_TARGET ?= aarch64-unknown-nto-qnx800
TARGET_DIR  := $(PROJECT_ROOT)/lib/$(QNN_TARGET)

libGenie      := $(TARGET_DIR)/libGenie.so
libtokenizers := $(QUALLA_DIR)/tokenizers/rust/target/$(RUST_TARGET)/release/libtokenizers_capi.a

COMMON_CXXFLAGS := -std=c++20 -fPIC -Wall -pg -pthread $(INCLUDES) -D_GNU_SOURCE -D_QNX_SOURCE -DUSE_POSIX_MADVISE
COMMON_LDFLAGS  := -shared -s -fPIC -pthread -L$(dir $(libtokenizers))
LIBS           += -lc++

ifdef QNN_DEBUG_ENABLE
	CXXFLAGS += $(COMMON_CXXFLAGS) -O0 -g -DQNN_API="" -DSPILLFILL -DQUALLA_ENGINE_QNN_CPU=TRUE -DQUALLA_ENGINE_QNN_GPU=TRUE -DQUALLA_ENGINE_QNN_HTP=TRUE -DFMT_HEADER_ONLY -DGENIE_SAMPLE
    LDFLAGS  += $(COMMON_LDFLAGS)
else
	CXXFLAGS += $(COMMON_CXXFLAGS) -O3 -Wno-write-strings -fvisibility=hidden -DQNN_API="" -DGENIE_API="__attribute__((visibility(\"default\")))" -DSPILLFILL -DQUALLA_ENGINE_QNN_CPU=TRUE -DQUALLA_ENGINE_QNN_GPU=TRUE -DQUALLA_ENGINE_QNN_HTP=TRUE -DFMT_HEADER_ONLY -DGENIE_SAMPLE
    LDFLAGS  += $(COMMON_LDFLAGS) -fvisibility=hidden -flto
endif

# ----------------------------------------------------------------------------
# Sources
# ----------------------------------------------------------------------------

SRC_DIR_COLLECTION := \
	$(SRC_DIR_GENIE) \
	$(SRC_DIR_GENIE_PIPELINE) \
	$(SRC_DIR_GENIE_TRACE) \
	$(SRC_DIR_GENIE_QUANT) \
	$(SRC_DIR_QUALLA_CORE) \
	$(SRC_DIR_QUALLA_STATE) \
	$(SRC_DIR_TOKENIZERS) \
	$(SRC_DIR_ADAPTORS) \
	$(SRC_DIR_DIALOGS) \
	$(SRC_DIR_TEXT_ENCODERS) \
	$(SRC_DIR_IMAGE_ENCODERS) \
	$(SRC_DIR_UTILS) \
	$(SRC_DIR_LOGGERS) \
	$(SRC_DIR_SAMPLERS) \
	$(SRC_DIR_MMAPPED_UTILS) \
	$(SRC_DIR_ENGINES) \
	$(SRC_DIR_QNN_API) \
	$(SRC_DIR_QNN_API_CONFIG) \
	$(SRC_DIR_QNN_API_BUFFER) \
	$(SRC_DIR_QNN_API_BUFFER_ALLOC) \
	$(SRC_DIR_QNN_API_BUFFER_REG) \
	$(SRC_DIR_QNN_API_PAL) \
	$(SRC_DIR_QNN_API_PAL_LINUX) \
	$(SRC_DIR_QNN_CPU) \
	$(SRC_DIR_QNN_GPU) \
	$(SRC_DIR_QNN_HTP) \
	$(SRC_DIR_QNN_NSP_UTILS) \
	$(SRC_DIR_QNN_KV_CACHE)

SOURCES := $(foreach dir,$(SRC_DIR_COLLECTION),$(wildcard $(dir)/*.cpp))

# Make sure qnn-htp.cpp from engines root is included exactly once
SOURCES += $(filter $(SRC_DIR_ENGINES)/qnn-htp.cpp,$(wildcard $(SRC_DIR_ENGINES)/qnn-htp.cpp))
SOURCES := $(sort $(SOURCES))

# ----------------------------------------------------------------------------
# Object Directories
# ----------------------------------------------------------------------------
OBJ_ROOT := $(PROJECT_ROOT)/obj
OBJ_DIR_BASE := $(OBJ_ROOT)/$(QNN_TARGET)
OBJECTS := $(patsubst $(PROJECT_ROOT)/%.cpp,$(OBJ_DIR_BASE)/%.o,$(SOURCES))

# ----------------------------------------------------------------------------
# Rules
# ----------------------------------------------------------------------------
.PHONY: all clean aarch64-qnx libGenie

all: libGenie
aarch64-qnx: libGenie

libGenie: $(OBJECTS) | $(TARGET_DIR)
	$(CXX) $(LDFLAGS) -o $@ $^ $(libtokenizers) $(LIBS)

$(OBJ_DIR_BASE)/%.o: $(PROJECT_ROOT)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(TARGET_DIR):
	mkdir -p $@

clean:
	rm -rf $(OBJ_ROOT) $(TARGET_DIR)
